{
  "entities": {
    "users": {
      "title": "User",
      "description": "Perfiles de usuarios, aliados comerciales y administradores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "documentId": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "ally"] },
        "businessName": { "type": "string" },
        "zone": { "type": "string" },
        "pointsBalance": { "type": "number" },
        "totalPointsEarned": { "type": "number" },
        "totalPointsRedeemed": { "type": "number" },
        "tempPassword": { "type": "string" },
        "tempPasswordExpiresAt": { "type": "string" },
        "mustResetPassword": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "documentId", "role"]
    },
    "products": {
      "title": "Product",
      "description": "Premios y artículos del catálogo de canjes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "pointsCost": { "type": "number" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "brand": { "type": "string" },
        "isDigital": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "pointsCost", "stock"]
    },
    "campaigns": {
      "title": "CommercialCampaign",
      "description": "Campañas comerciales de acumulación de puntos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "pointsPerUnit": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name", "pointsPerUnit"]
    },
    "gestiones": {
      "title": "ReportedGestion",
      "description": "Ventas y gestiones SOAT reportadas por aliados para validación",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reportedByUserId": { "type": "string" },
        "allyName": { "type": "string" },
        "allyDocument": { "type": "string" },
        "campaignId": { "type": "string" },
        "campaignName": { "type": "string" },
        "pointsPerUnit": { "type": "number" },
        "unitsCount": { "type": "number" },
        "totalPointsCalculated": { "type": "number" },
        "policyNumber": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reportedAt": { "type": "string" }
      },
      "required": ["id", "reportedByUserId", "campaignId", "unitsCount", "status"]
    },
    "orders": {
      "title": "RedemptionOrder",
      "description": "Órdenes de canje y entrega de premios",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userDocument": { "type": "string" },
        "totalPoints": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "shipped", "delivered", "cancelled"] },
        "redeemedAt": { "type": "string" }
      },
      "required": ["id", "userId", "totalPoints", "status"]
    },
    "transactions": {
      "title": "PointsTransaction",
      "description": "Libro mayor y auditoría de transacciones de puntos",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "points": { "type": "number" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "type", "points", "timestamp"]
    },
    "notifications": {
      "title": "AppNotification",
      "description": "Notificaciones del sistema para usuarios",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message"]
    },
    "accessLogs": {
      "title": "AccessLog",
      "description": "Registro de auditoría y accesos al sistema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "eventType": { "type": "string" }
      },
      "required": ["id", "timestamp", "userId", "eventType"]
    }
  }
}
