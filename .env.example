# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ============================================
# CONFIGURACIÓN DE GOOGLE SHEETS
# ============================================
# ID de tu hoja de cálculo de Google Sheets
# Formato: https://docs.google.com/spreadsheets/d/[ESTE_ES_EL_ID]/edit
VITE_GOOGLE_SPREADSHEET_ID="18T8ZOHYRFIKyG8W24gwydRBwoJPAA_XsSJporVR-CgM"

# ============================================
# CONFIGURACIÓN DE FIREBASE
# ============================================
# Proyecto: superpuntos
# Cuenta: supergestionesintegrales@gmail.com
# 
# IMPORTANTE: Obtén estas credenciales desde Firebase Console:
# 1. Ve a: https://console.firebase.google.com/
# 2. Selecciona el proyecto "superpuntos"
# 3. Ve a Project Settings > Your apps > Config
# 4. Copia los valores y pégalos aquí

VITE_FIREBASE_API_KEY="OBTENER_DE_FIREBASE_CONSOLE"
VITE_FIREBASE_AUTH_DOMAIN="superpuntos.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="superpuntos"
VITE_FIREBASE_STORAGE_BUCKET="superpuntos.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="OBTENER_DE_FIREBASE_CONSOLE"
VITE_FIREBASE_APP_ID="OBTENER_DE_FIREBASE_CONSOLE"

# Opcional: Google Analytics Measurement ID
VITE_FIREBASE_MEASUREMENT_ID=""
